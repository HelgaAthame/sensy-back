# Скопируйте в .env и заполните под своё окружение (см. docker-compose.yml для дефолтных значений при локальном запуске)

# Postgres
DATABASE_URL="postgresql://sensy:sensy@localhost:5432/sensy?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Redis (BullMQ) — понадобится с Фазы 1
REDIS_URL="redis://localhost:6379"

# MinIO (S3-совместимое хранилище) — понадобится с Фазы 1
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="sensy"
S3_SECRET_KEY="sensy12345"
S3_BUCKET="mediafiles"

# Ollama (self-hosted LLM) — понадобится с Фазы 4
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

PORT=5187
