generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Operator {
  id         Int         @id @default(autoincrement())
  name       String?
  mediaFiles MediaFile[]
}

model Project {
  id                 Int                  @id @default(autoincrement())
  name               String?
  isActive           Boolean              @default(true)
  dictionaryProjects DictionaryProject[]
  checklistProjects  ChecklistProject[]
  mediaFiles         MediaFile[]
}

enum DictionaryType {
  All
  OnlyOperator
  OnlyClient
  Hotwords
}

model Dictionary {
  id                 Int                  @id @default(autoincrement())
  name               String?
  isActive           Boolean              @default(true)
  type               DictionaryType
  colorHex           String
  phrases            Json
  dictionaryProjects DictionaryProject[]
}

model DictionaryProject {
  dictionaryId Int
  projectId    Int
  dictionary   Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([dictionaryId, projectId])
}

model Checklist {
  id                Int                  @id @default(autoincrement())
  name              String?
  isActive          Boolean              @default(true)
  data              Json?
  checklistProjects ChecklistProject[]
  mediaFileChecklists MediaFileChecklist[]
}

model ChecklistProject {
  checklistId Int
  projectId   Int
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([checklistId, projectId])
}

enum MediaFileStatus {
  Processing
  Ready
  Failed
}

model MediaFile {
  id             Int             @id @default(autoincrement())
  fileName       String?
  storageKey     String
  numChannels    Int?
  sampleRate     Int?
  duration       Float?
  operatorId     Int?
  operator       Operator?       @relation(fields: [operatorId], references: [id])
  projectId      Int?
  project        Project?        @relation(fields: [projectId], references: [id])
  createDate     DateTime
  lastAccessUtc  DateTime        @default(now())
  status         MediaFileStatus @default(Processing)
  isFailed       Boolean         @default(false)
  failureReason  String?
  outerId        String?
  clientId       String?
  clientNumber   String?
  direction      String?

  // денормализованные агрегаты для сортировки/фильтрации списка (заполняются в Фазах 2-3)
  negativeLevelOverall           Float?
  keywordsCount                  Int?   @default(0)
  maxSimultaneousSilenceDuration Float?
  simultaneousSpeechCount        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result     MediaFileResult?
  checklists MediaFileChecklist[]

  @@index([createDate])
  @@index([operatorId])
  @@index([projectId])
}

// Применённый к конкретному звонку чек-лист: изначально заполняется GPT
// (Фаза 4, POST api/mediafile/:id/gpt-analysis), затем оператор может
// поправить оценки через PUT api/mediafile/:id?checklistId=X.
model MediaFileChecklist {
  mediaFileId Int
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  checklistId Int
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  // ChecklistItem: { name, minScore, maxScore, score, blocks: [{ name, minScore, maxScore, score,
  // criterias: [{ name, minScore, maxScore, score, help, comment, scale }] }] }
  data Json

  updatedAt DateTime @updatedAt

  @@id([mediaFileId, checklistId])
}

model MediaFileResult {
  mediaFileId Int       @id
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  stt                  Json?
  tonal                Json?
  simultaneousSpeech   Json?
  simultaneousSilence  Json?
  keywordsSearchResult Json?
  // Готовый summaryAnalyserResult для списка/аналитики — считается один раз в
  // AnalysisProcessor, чтобы не пересчитывать агрегаты по jsonb на каждый GET.
  summaryAnalyserResult Json?

  gptSummary String?
  // Оценки по чек-листам (изначально от GPT, поправляемые оператором) хранятся
  // отдельно в MediaFileChecklist — по одной записи на пару (звонок, чек-лист).

  updatedAt DateTime @updatedAt
}
